{
	auto_https off
	admin off
	servers {
		protocols h1 h2c
	}
}

:80 {
	handle /vless* {
		reverse_proxy 127.0.0.1:10000
	}

	handle /vless-hu* {
		reverse_proxy 127.0.0.1:10001
	}

	handle /vmess* {
		reverse_proxy 127.0.0.1:10002
	}

	handle /trojan* {
		reverse_proxy 127.0.0.1:10003
	}

	handle /vless-grpc* {
		reverse_proxy h2c://127.0.0.1:10004
	}

	handle {
		respond "OK" 200
	}
}
